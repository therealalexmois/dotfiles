# Copy this file to ~/.codex/config.local.toml and keep it local.
# Host-specific project trust entries, MCP servers, and plugins belong here.
# Do not put machine-specific MCP/plugin settings into config.shared.toml.

[projects."/Users/<your-username>/work/<work-project>"]
trust_level = "trusted"

[projects."/Users/<your-username>/projects/<another-project>"]
trust_level = "trusted"

[projects."/Users/<your-username>/.dotfiles"]
trust_level = "trusted"

# Example for a corporate workstation only:
# [mcp_servers.dpJira]
# command = "dp"
# args = ["ai", "mcp", "jira", "--read-only"]
