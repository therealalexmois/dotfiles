{
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.03,
  "attribution": {
    "commit": ""
  },
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": %s}}' \"$(jq -Rs '.' ~/.claude/skills/claude-coach/coach-context.md)\"",
            "statusMessage": "Loading claude-coach..."
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-create.sh",
            "statusMessage": "Creating worktree..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.local/share",
        "~/.local/state",
        "~/.local/bin",
        "~/.npm",
        "~/.cargo",
        "~/.dp",
        "~/Visuals/figures"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.local/share/zsh/local.zsh", "mode": "deny" }
      ],
      "envVars": [
        { "name": "LLM_PROXY_TOKEN", "mode": "deny" },
        { "name": "DP_GITLAB_TOKEN", "mode": "deny" },
        { "name": "GITLAB_TOKEN", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/ai-agents/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "language": "russian",
  "effortLevel": "xhigh",
  "voice": {
    "enabled": false,
    "mode": "tap"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light-ansi",
  "editorMode": "vim",
  "voiceEnabled": false
}
