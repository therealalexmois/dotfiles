{
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.03,
  "attribution": {
    "commit": ""
  },
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-skip-worktree.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-on-edit.sh",
            "statusMessage": "Linting edited file..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": %s}}' \"$(jq -Rs '.' ~/.claude/skills/claude-coach/references/coach-context.md)\"",
            "statusMessage": "Loading claude-coach..."
          }
        ]
      },
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-recap.sh",
            "statusMessage": "Preparing session recap..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5,
            "statusMessage": "Loading llm-wiki session context"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-create.sh",
            "statusMessage": "Creating worktree..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5,
            "statusMessage": "Checking llm-wiki session context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5,
            "statusMessage": "Capturing llm-wiki pre-compact session context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5,
            "statusMessage": "Capturing llm-wiki post-compact session context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-wiki-session.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.local/share",
        "~/.local/state",
        "~/.local/bin",
        "~/.npm",
        "~/.cargo",
        "~/.dp",
        "~/Visuals/figures"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.local/share/zsh/local.zsh", "mode": "deny" }
      ],
      "envVars": [
        { "name": "LLM_PROXY_TOKEN", "mode": "deny" },
        { "name": "DP_GITLAB_TOKEN", "mode": "deny" },
        { "name": "GITLAB_TOKEN", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.dotfiles/ai-agents/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "wiki@llm-wiki": true
  },
  "extraKnownMarketplaces": {
    "llm-wiki": {
      "source": {
        "source": "github",
        "repo": "nvk/llm-wiki"
      }
    }
  },
  "language": "russian",
  "effortLevel": "xhigh",
  "voice": {
    "enabled": false,
    "mode": "tap"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light-ansi",
  "editorMode": "vim",
  "voiceEnabled": false
}
