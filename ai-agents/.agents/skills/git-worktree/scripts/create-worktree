#!/usr/bin/env bash
# Bundled git-worktree command for creating a named branch and worktree.
#
# Contract: accept --name and --cwd, honor an explicit absolute --path, and
# require a confirmed ignore mode before configuring the default `.worktrees/`
# location. Print only the absolute worktree path on stdout by default, and
# return non-zero before creation when preflight or remote refresh fails.
# Optional JSON output is machine-readable. Provisioning remains best-effort.

set -uo pipefail

err() { printf 'create-worktree: %s\n' "$1" >&2; }

usage() {
  printf '%s\n' \
    'usage: create-worktree --name <name> --cwd <repository-path> [--path <absolute-path>]' \
    '       [--ignore-mode info-exclude|gitignore] [--format path|json]' >&2
}

worktree_name=""
cwd=""
requested_path=""
name_set=0
output_format="path"
ignore_mode="existing"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)
      [[ $# -ge 2 ]] || { err "--name requires a value"; usage; exit 2; }
      worktree_name="$2"
      name_set=1
      shift 2
      ;;
    --cwd)
      [[ $# -ge 2 ]] || { err "--cwd requires a value"; usage; exit 2; }
      cwd="$2"
      shift 2
      ;;
    --path)
      [[ $# -ge 2 ]] || { err "--path requires a value"; usage; exit 2; }
      requested_path="$2"
      shift 2
      ;;
    --ignore-mode)
      [[ $# -ge 2 ]] || { err "--ignore-mode requires a value"; usage; exit 2; }
      case "$2" in
        info-exclude | gitignore) ignore_mode="$2" ;;
        *) err "--ignore-mode must be info-exclude or gitignore"; usage; exit 2 ;;
      esac
      shift 2
      ;;
    --format)
      [[ $# -ge 2 ]] || { err "--format requires a value"; usage; exit 2; }
      case "$2" in
        path | json) output_format="$2" ;;
        *) err "--format must be path or json"; usage; exit 2 ;;
      esac
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "unknown argument: $1"
      usage
      exit 2
      ;;
  esac
done

[[ "$name_set" -eq 1 ]] || { err "--name is required"; usage; exit 2; }
[[ -n "$cwd" ]] || { err "--cwd is required"; usage; exit 2; }
command -v git >/dev/null 2>&1 || { err "git not found"; exit 1; }
if [[ "$output_format" == "json" ]]; then
  command -v jq >/dev/null 2>&1 || { err "jq is required for --format json"; exit 1; }
fi

repo_root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || {
  err "not a git repository: $cwd"
  exit 1
}

if [[ -n "$requested_path" ]]; then
  case "$requested_path" in
    /*) ;;
    *) err "--path must be absolute"; exit 2 ;;
  esac
  [[ "$ignore_mode" == "existing" ]] || {
    err "--ignore-mode cannot be used with --path"
    exit 2
  }
fi

# conventionalbranch.org: lowercase a-z0-9, hyphens between words, dots only
# in release versions. Keep `/` so an existing `type/...` prefix survives.
sanitize() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's#[^a-z0-9._/-]+#-#g; s#-{2,}#-#g; s#\.{2,}#.#g; s#^[-._/]+##; s#[-._/]+$##'
}

known_type='feature|feat|bugfix|fix|hotfix|release|chore|ai|copilot|cursor|claude|codex'
default_type='feat'
clean=$(sanitize "$worktree_name")

# Claude may omit a meaningful name for `claude -w`. Since this command owns
# creation, synthesize the same kind of stable unique fallback locally.
case "$clean" in
  "" | worktree | wt) clean="wt-$(date '+%Y%m%d-%H%M%S')" ;;
esac

if printf '%s' "$clean" | grep -qE "^(${known_type})/"; then
  branch="$clean"
else
  branch="$default_type/$clean"
fi

git check-ref-format --branch "$branch" >/dev/null 2>&1 || {
  err "invalid branch name after normalization: $branch"
  exit 1
}

# Keep worktrees flat even though branches keep their conventional type prefix.
dir_name=$(printf '%s' "$branch" | tr '/' '-')
if [[ -n "$requested_path" ]]; then
  path="$requested_path"
  default_location=false
else
  path="$repo_root/.worktrees/$dir_name"
  default_location=true
fi

# The caller performs the conversational preflight. This guard keeps direct
# callers from changing ignore files or fetching before that choice is explicit.
if [[ "$default_location" == true ]]; then
  ignore_probe=".worktrees/.git-worktree-preflight"
  if ! git -C "$repo_root" check-ignore -q --no-index "$ignore_probe" 2>/dev/null; then
    case "$ignore_mode" in
      existing)
        err ".worktrees is not ignored; confirm --ignore-mode info-exclude or gitignore"
        exit 3
        ;;
      info-exclude)
        git_common=$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null) || {
          err "cannot resolve Git common directory"
          exit 1
        }
        case "$git_common" in
          /*) ;;
          *) git_common="$repo_root/$git_common" ;;
        esac
        ignore_file="$git_common/info/exclude"
        ;;
      gitignore)
        ignore_file="$repo_root/.gitignore"
        ;;
    esac

    if grep -Fqx '/.worktrees/' "$ignore_file" 2>/dev/null; then
      err "existing /.worktrees/ rule in $ignore_file is not effective; refusing to duplicate it"
      exit 1
    fi
    mkdir -p "$(dirname "$ignore_file")"
    printf '/.worktrees/\n' >>"$ignore_file" || {
      err "cannot update ignore rules in $ignore_file"
      exit 1
    }
    git -C "$repo_root" check-ignore -q --no-index "$ignore_probe" 2>/dev/null || {
      err "added ignore rule is not effective: $ignore_file"
      exit 1
    }
  fi
fi

# Refresh the canonical remote before resolving origin/HEAD. A failed fetch is
# an explicit blocker so the command cannot silently branch from stale state.
if ! git -C "$repo_root" fetch origin >&2; then
  err "git fetch origin failed"
  exit 1
fi

base_ref=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
[[ -n "$base_ref" ]] || base_ref=HEAD

# Git writes progress to stderr so stdout remains machine-readable for callers.
if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
  branch_created=false
  git -C "$repo_root" worktree add "$path" "$branch" >&2
  rc=$?
else
  branch_created=true
  git -C "$repo_root" worktree add "$path" -b "$branch" "$base_ref" >&2
  rc=$?
fi
[[ "$rc" -eq 0 ]] || { err "git worktree add failed (rc=$rc)"; exit 1; }

# Copy listed ignored local files without duplicating tracked content. Invalid
# paths and virtual environments are skipped after creation, with a warning.
include="$repo_root/.worktreeinclude"
if [[ -f "$include" ]]; then
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw#"${raw%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    case "$line" in \#*) continue ;; esac
    case "$line" in
      /* | ../* | */../* | */..)
        err "skipping unsafe include path: $line"
        continue
        ;;
      .venv | .venv/ | */.venv | */.venv/)
        err "skipping $line (recreate venv with uv, not copyable)"
        continue
        ;;
    esac
    src="$repo_root/$line"
    [[ -e "$src" ]] || continue
    git -C "$repo_root" check-ignore -q "$line" 2>/dev/null || continue
    dest="$path/$line"
    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest" 2>/dev/null || err "could not copy $line"
  done <"$include"
fi

# Share the repo's `.claude` (project skills, commands, local settings) with the
# worktree. It is gitignored, so `git worktree add` never brings it in. Symlink
# rather than copy so project skills stay in sync with the main worktree. The
# default worktree lives at `<repo>/.worktrees/<dir>`, so `../../.claude`
# resolves back to the repo root. Explicit paths use the absolute source.
# Best-effort: never aborts a created worktree.
if [[ -e "$repo_root/.claude" && ! -e "$path/.claude" ]]; then
  if [[ "$default_location" == true ]]; then
    claude_source="../../.claude"
  else
    claude_source="$repo_root/.claude"
  fi
  ln -s "$claude_source" "$path/.claude" 2>/dev/null || err "could not link .claude"
fi

# Prefer a repository setup script, then provision uv projects. Provisioning is
# best-effort because the branch and worktree already exist at this point.
log_file="${XDG_STATE_HOME:-$HOME/.local/state}/create-worktree.log"
mkdir -p "$(dirname "$log_file")" 2>/dev/null || true
setup=""
provisioning_method="none"
provisioning_status="skipped"
for candidate in "$repo_root/.worktree-setup.sh" "$repo_root/scripts/worktree-setup.sh"; do
  [[ -x "$candidate" ]] && { setup="$candidate"; break; }
done
if [[ -n "$setup" ]]; then
  provisioning_method="repository-script"
  if (cd "$path" && "$setup") >>"$log_file" 2>&1; then
    provisioning_status="completed"
  else
    provisioning_status="failed"
    err "worktree setup script failed (see $log_file); provision manually"
  fi
elif [[ -f "$path/uv.lock" ]] && command -v uv >/dev/null 2>&1; then
  provisioning_method="uv"
  if (cd "$path" && uv venv && uv sync) >>"$log_file" 2>&1; then
    provisioning_status="completed"
  else
    provisioning_status="failed"
    err "uv provisioning failed (see $log_file); run 'uv venv && uv sync' manually"
  fi
fi

if [[ "$output_format" == "json" ]]; then
  jq -nc \
    --arg repository "$repo_root" \
    --arg worktree "$path" \
    --arg branch "$branch" \
    --arg base_ref "$base_ref" \
    --argjson branch_created "$branch_created" \
    --arg provisioning_method "$provisioning_method" \
    --arg provisioning_status "$provisioning_status" \
    '{format_version: 1, repository: $repository, worktree: $worktree, branch: $branch, base_ref: $base_ref, branch_created: $branch_created, provisioning: {method: $provisioning_method, status: $provisioning_status}}'
else
  printf '%s\n' "$path"
fi
